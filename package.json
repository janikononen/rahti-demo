{
  "name": "rahti-demo",
  "version": "1.0.0",
  "description": "root level package.json for scripts",
  "homepage": "https://github.com/janikononen/rahti-demo#readme",
  "bugs": {
    "url": "https://github.com/janikononen/rahti-demo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janikononen/rahti-demo.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build:app:image": "cd demo && docker build -t rahti-demo:latest .",
    "docker:app:local": "bash demo/hack/docker-app-local",
    "docker:network:local": "bash demo/hack/docker-network-local",
    "docker:postgresql:local": "bash demo/hack/docker-postgresql-local",
    "clean:local": "bash demo/hack/clean-local",
    "dev": "npm-run-all docker:network:local docker:postgresql:local docker:app:local"
  },
  "dependencies": {
    "npm-run-all": "^4.1.5"
  }
}
